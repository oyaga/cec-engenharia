# PRODUÇÃO — copie para `.env` (mesmo diretório do docker-compose.prod.yml)
# e preencha. NUNCA comite o .env real. Use segredos FORTES.

# ─── Banco ───
POSTGRES_USER=cec
POSTGRES_PASSWORD=            # obrigatório — gere: openssl rand -base64 32
POSTGRES_DB=cec

# ─── Servidor / domínio ───
# Domínio(s) público(s) do painel (separe por vírgula se houver mais de um).
CORS_ORIGINS=https://cursocec.com.br
PUBLIC_URL=https://cursocec.com.br

# ─── Auth ───
JWT_SECRET=                  # obrigatório — gere: openssl rand -base64 48
JWT_TTL_HOURS=12

# ─── Asaas (pagamentos) ───
ASAAS_ENV=production
ASAAS_API_KEY=               # chave de produção do Asaas
ASAAS_WEBHOOK_TOKEN=         # token que o Asaas envia no header do webhook

# ─── Maria Antônia / WhatsApp ───
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
AI_PROVIDER=                 # anthropic | openai
AI_API_KEY=
MARIA_ATTENDANT=             # ex: 5521XXXXXXXXX@s.whatsapp.net
