# ─── Servidor ───────────────────────────────
APP_ENV=development            # development | production
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:5173

# ─── Banco (bate com docker-compose.yml) ─────
DATABASE_URL=postgres://cec:cec_dev_password@localhost:5432/cec?sslmode=disable

# ─── Redis (cache dos endpoints públicos) ────
# Vazio = cache desabilitado (a API funciona normalmente sem ele).
REDIS_URL=redis://localhost:6379

# ─── Storage local (uploads) ─────────────────
# STORAGE_DIR: pasta onde os arquivos enviados ficam salvos.
# PUBLIC_URL: base usada para montar a URL pública dos arquivos (GET /files/*).
STORAGE_DIR=./uploads
PUBLIC_URL=http://localhost:8080

# ─── Auth ────────────────────────────────────
# Gere um segredo forte para produção: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-em-producao
JWT_TTL_HOURS=12

# ─── Seed de desenvolvimento ─────────────────
# Se true e não houver nenhum usuário, cria um admin inicial no arranque.
SEED_DEV=true
SEED_ADMIN_EMAIL=admin@cec.local
SEED_ADMIN_PASSWORD=admin123

# ─── Asaas (Fase 3 — server-side) ────────────
# A chave também pode ser definida pela tela ConfigAsaas (system_settings);
# o env serve de fallback. NUNCA vai ao browser.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=          # token que o Asaas envia no header do webhook

# ─── Maria Antônia / WhatsApp (Fase 4) ───────
EVOLUTION_API_URL=            # ex: https://evo.seudominio.com
EVOLUTION_API_KEY=
AI_PROVIDER=                  # anthropic | openai
AI_API_KEY=
MARIA_ATTENDANT=             # ex: 5521XXXXXXXXX@s.whatsapp.net

# ─── E-mail transacional (Resend) ─────────────
# Sem RESEND_API_KEY, todos os envios viram no-op logado (não falham).
# Crie uma chave em https://resend.com e verifique o domínio remetente.
RESEND_API_KEY=               # ex: re_XXXXXXXXXXXXXXXXXXXXXXXX
MAIL_FROM=CEC Engenharia <nao-responda@cursocec.com.br>
SECRETARIA_EMAIL=             # e-mail que recebe notificações de lead/contato

# ─── Frontend SPA embutido (imagem única) ────
# Deixe vazio em desenvolvimento (o Vite serve o frontend na porta 5173).
# Em produção, aponte para o diretório do build: WEB_DIR=/app/dist
WEB_DIR=
