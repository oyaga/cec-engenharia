# Frontend para análise LOCAL (build Vite + nginx com proxy same-origin p/ API).
# Node 22: exigido por Vite 7 + Tailwind v4 (engine oxide). Node 18 não gera as utilitárias.
FROM node:22-alpine AS build
WORKDIR /app

# API relativa (mesma origem) — o nginx faz o proxy para o serviço "api".
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.dev.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
